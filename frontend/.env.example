# ─── Kurulum ─────────────────────────────────────────────────────────
# 1. cp .env.example .env.local
# 2. .env.local gitignore'da; commit edilmez.
# 3. Üretim build'inde VITE_API_BASE_URL boş bırakılır —
#    nginx /api/* → backend proxy'si devreye girer.

# ─── API ─────────────────────────────────────────────────────────────
# Local geliştirme: Vite proxy bu adrese yönlendirir.
# Production: boş bırakın (nginx proxy kullanılır).
VITE_API_BASE_URL=http://localhost:8080

# ─── Map tiles ───────────────────────────────────────────────────────
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions">CARTO</a>

# ─── App metadata ────────────────────────────────────────────────────
VITE_APP_TITLE=Afet Koordinasyon Platformu

# ─── Developer tools (production'da false olsun) ─────────────────────
VITE_ENABLE_DEVTOOLS=false

# ─── Session storage key ─────────────────────────────────────────────
VITE_SESSION_STORAGE_KEY=rt
