# ─── API ─────────────────────────────────────────────────────────────
# Base URL of the Spring Boot backend (no trailing slash, no /api suffix)
# In dev the Vite proxy handles /api → localhost:8080, so this can be empty.
# In production set to the actual backend URL.
VITE_API_BASE_URL=http://localhost:8080

# ─── Map tiles ───────────────────────────────────────────────────────
# CartoDB light (default, no API key required)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions">CARTO</a>

# ─── App metadata ────────────────────────────────────────────────────
VITE_APP_TITLE=Afet Koordinasyon Platformu

# ─── Developer tools (set to false in production) ────────────────────
VITE_ENABLE_DEVTOOLS=false

# ─── Session storage key (local storage key for refresh token) ───────
VITE_SESSION_STORAGE_KEY=rt
