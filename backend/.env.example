# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=afetdb
POSTGRES_USER=afetuser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST_PORT=5433

# ─── Spring Boot datasource (used by the app, not docker-compose) ─────
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/afetdb
SPRING_DATASOURCE_USERNAME=afetuser
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────────────
# Must be at least 256 bits (32 characters) for HS256
JWT_SECRET=change_this_to_a_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=2592000000

# ─── Mail ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ─── Storage ─────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# ─── Email mode: "prod" sends real emails, "mock" logs to console ─────
EMAIL_TYPE=prod

# ─── Server ──────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Frontend / Short links ──────────────────────────────────────────
# Frontend uygulamasının ana adresi (kısa linklerin yönlendirdiği yer)
FRONTEND_URL=http://localhost:5173
# /s/{code} redirect endpoint'inin sunulduğu backend public adresi
SHORT_LINK_BASE_URL=http://localhost:8080

# ─── WhatsApp Business Cloud API ─────────────────────────────────────
# enabled=false iken tüm WhatsApp gönderimi sessizce atlanır.
WHATSAPP_ENABLED=false
# test-mode=true iken tüm mesajlar WHATSAPP_TEST_RECIPIENT numarasına gider.
WHATSAPP_TEST_MODE=true
# Tek test alıcısı (E.164, örn. +905551112233)
WHATSAPP_TEST_RECIPIENT=
# Meta WhatsApp Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=
# Meta Graph API erişim token'ı — GİZLİ, asla frontend'e veya loglara gitmez
WHATSAPP_ACCESS_TOKEN=
# Graph API sürümü
WHATSAPP_API_VERSION=v20.0
WHATSAPP_BASE_URL=https://graph.facebook.com
# Deprem/simülasyon bildirimleri YALNIZCA approved template ile gönderilir (text fallback YOK).
# Template adı boş bırakılırsa deprem WhatsApp bildirimi gönderilmez (error log yazılır).
#   - Geçici test: hello_world (parametresiz) + dil en_US
#   - Production:  earthquake_alert_tr (parametreli: magnitude, location, occurredAt, shortLink) + dil tr
# templateName=hello_world ise parametre gönderilmez; aksi halde body parametreleri gönderilir.
WHATSAPP_EARTHQUAKE_TEMPLATE_NAME=hello_world
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_LANGUAGE_CODE=en_US
