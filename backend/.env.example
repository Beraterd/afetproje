# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=afetdb
POSTGRES_USER=afetuser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST_PORT=5433

# ─── Spring Boot datasource (used by the app, not docker-compose) ─────
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/afetdb
SPRING_DATASOURCE_USERNAME=afetuser
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────────────
# Must be at least 256 bits (32 characters) for HS256
JWT_SECRET=change_this_to_a_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=2592000000

# ─── Mail ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ─── Storage ─────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# ─── Email mode: "prod" sends real emails, "mock" logs to console ─────
EMAIL_TYPE=prod

# ─── Server ──────────────────────────────────────────────────────────
SERVER_PORT=8080
